<?php

namespace App\Http\Controllers\Backend;

use App\Http\Controllers\Controller;
use App\Http\Requests\Backend\StoreGadgetRequest;
use App\Http\Requests\Backend\UpdateGadgetRequest;
use App\Models\Gadget;
use App\Services\UploadDocumentService;
use Exception;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Gate;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Storage;
use Symfony\Component\HttpFoundation\Response;

class GadgetController extends Controller
{
    public function index()
    {
        abort_if(Gate::denies('gadgets index'), Response::HTTP_FORBIDDEN);

        if (request()->ajax()) {
            $query = Gadget::with(['translation', 'files'])->orderBy('id', 'desc');

            if (request()->filled('search')) {
                $search = request('search');
                $query->whereHas('translations', function ($q) use ($search) {
                    $q->where('title', 'like', "%$search%");
                });
            }

            return $this->dataTable($query);
        }

        return view('backend.gadgets.index');
    }

    public function create()
    {
        abort_if(Gate::denies('gadgets create'), Response::HTTP_FORBIDDEN);

        $edit = false;
        $langs = active_langs();

        return view('backend.gadgets.form', compact('edit', 'langs'));
    }

    public function store(StoreGadgetRequest $request, UploadDocumentService $uploadDocumentService)
    {
        abort_if(Gate::denies('gadgets create'), Response::HTTP_FORBIDDEN);

        $data = $request->validated();

        DB::beginTransaction();

        try {
            $gadget = Gadget::create([
                'slug' => $data['slug'],
                'status' => $data['status'],
                'publish_date' => $data['publish_date'],
                'sku' => $data['sku'],
                'notes' => $data['notes'] ?? null,
                'order' => $data['order'] ?? 1,
            ]);

            foreach (active_langs() as $lang) {
                $gadget->translations()->create([
                    'locale' => $lang->code,
                    'title' => $data['title:' . $lang->code],
                    'body' => $data['body:' . $lang->code],
                    'summary' => $data['summary:' . $lang->code] ?? null,
                ]);
            }

            if ($request->hasFile('cover')) {
                $uploadDocumentService->upload('gadget', 'cover', $gadget->id, 'gadget_cover', true, $request);
            }

            DB::commit();

            return redirect(route('backend.gadgets.index'))
                ->withSuccess(trans('backend.messages.success.create'));
        } catch (Exception $e) {
            DB::rollBack();
            Log::error($e->getMessage());

            return redirect()->back()->withError(trans('backend.messages.error.create'));
        }
    }

    public function show(Gadget $gadget)
    {
        abort_if(Gate::denies('gadgets index'), Response::HTTP_FORBIDDEN);

        $gadget->load(['translations', 'files']);
        $langs = active_langs();
        $translations = $langs->mapWithKeys(fn ($lang) => [$lang->code => $gadget->translate($lang->code)]);

        return view('backend.gadgets.show', compact('gadget', 'langs', 'translations'));
    }

    public function edit(Gadget $gadget)
    {
        abort_if(Gate::denies('gadgets edit'), Response::HTTP_FORBIDDEN);

        $edit = true;
        $langs = active_langs();

        return view('backend.gadgets.form', compact('gadget', 'edit', 'langs'));
    }

    public function update(UpdateGadgetRequest $request, Gadget $gadget, UploadDocumentService $uploadDocumentService)
    {
        abort_if(Gate::denies('gadgets edit'), Response::HTTP_FORBIDDEN);

        $data = $request->validated();

        DB::beginTransaction();

        try {
            $gadget->update([
                'slug' => $data['slug'],
                'status' => $data['status'],
                'publish_date' => $data['publish_date'],
                'sku' => $data['sku'],
                'notes' => $data['notes'] ?? null,
                'order' => $data['order'] ?? $gadget->order,
            ]);

            foreach (active_langs() as $lang) {
                $gadget->translations()->updateOrCreate(
                    ['locale' => $lang->code],
                    [
                        'title' => $data['title:' . $lang->code],
                        'body' => $data['body:' . $lang->code],
                        'summary' => $data['summary:' . $lang->code] ?? null,
                    ]
                );
            }

            if ($request->hasFile('cover')) {
                $uploadDocumentService->upload('gadget', 'cover', $gadget->id, 'gadget_cover', true, $request);
            }

            DB::commit();

            return redirect(route('backend.gadgets.index'))
                ->withSuccess(trans('backend.messages.success.update'));
        } catch (Exception $e) {
            DB::rollBack();
            Log::error($e->getMessage());

            return redirect()->back()->withError(trans('backend.messages.error.update'));
        }
    }

    public function destroy(Gadget $gadget)
    {
        abort_if(Gate::denies('gadgets delete'), Response::HTTP_FORBIDDEN);

        try {
            foreach ($gadget->getDocuments('gadget_cover') as $file) {
                Storage::disk('documents')->delete($file->getAttributes()['document']);
                $file->delete();
            }

            $gadget->delete();

            return response(['status' => 1]);
        } catch (Exception $e) {
            Log::error($e->getMessage());

            return response(['status' => 0]);
        }
    }

    protected function dataTable($query)
    {
        return datatables()
            ->of($query)
            ->addColumn('checkbox', fn ($row) => '<div class="form-check form-check-sm form-check-custom form-check-solid">
                        <input class="form-check-input" type="checkbox" value="' . $row->id . '" />
                    </div>')
            ->addColumn('gadget', function ($row) {
                $src = $row->cover_image ?: ($row->first_image ?: asset('backend/img/noimage.jpg'));
                $title = e($row->translation->title ?? 'No Title');

                return '
                <div class="d-flex align-items-center">
                    <a href="' . route('backend.gadgets.edit', ['gadget' => $row->id]) . '" class="symbol symbol-50px">
                        <span class="symbol-label" style="background-image:url(' . $src . ');"></span>
                    </a>
                    <div class="ms-5">
                        <a href="' . route('backend.gadgets.edit', ['gadget' => $row->id]) . '" class="text-gray-800 text-hover-primary fs-5 fw-bold">' . $title . '</a>
                    </div>
                </div>';
            })
            ->addColumn('status', fn ($row) => badge($row->status))
            ->addColumn('publish_date', fn ($row) => is_object($row->publish_date) ? $row->publish_date->format('Y-m-d') : $row->publish_date)
            ->addColumn('actions', fn ($row) => $this->permissions($row->id))
            ->rawColumns(['checkbox', 'gadget', 'status', 'actions'])
            ->make(true);
    }

    protected function permissions($id)
    {
        $result = '<a href="#"
        class="btn btn-light btn-active-light-primary btn-flex btn-center btn-sm"
        data-kt-menu-trigger="click"
        data-kt-menu-placement="bottom-end">'
            . trans('backend.labels.actions') .
            '<i class="ki-outline ki-down fs-5 ms-1"></i>
        </a>';

        $result .= '<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-125px py-4" data-kt-menu="true">';

        if (admin()->can('gadgets index')) {
            $result .= '<div class="menu-item px-3">
                            <a href="' . route('backend.gadgets.show', ['gadget' => $id]) . '" class="menu-link px-3">' . trans('backend.buttons.view') . '</a>
                        </div>';
        }

        if (admin()->can('gadgets edit')) {
            $result .= '<div class="menu-item px-3">
                            <a href="' . route('backend.gadgets.edit', ['gadget' => $id]) . '" class="menu-link px-3">' . trans('backend.buttons.edit') . '</a>
                        </div>';
        }

        if (admin()->can('gadgets delete')) {
            $result .= '<div class="menu-item px-3">
                            <a href="' . route('backend.gadgets.destroy', ['gadget' => $id]) . '" class="menu-link px-3 btn-delete">' . trans('backend.buttons.delete') . '</a>
                        </div>';
        }

        $result .= '</div>';

        return $result;
    }
}
