@section('scripts')
    <script>
        $(document).ready(function() {
[% scripts %]
            $('#kt_[% morph_alias %]_form').on('submit', function(e) {
[% submit_scripts %]
                if (!ktValidateRequired(this)) {
                    e.preventDefault();
                    return;
                }

                $('#kt_[% morph_alias %]_submit').attr('data-kt-indicator', 'on').prop('disabled', true);
            });
        });
    </script>
@endsection
