<?php

namespace App\Http\Controllers\Backend;

use App\Http\Controllers\Controller;
use App\Http\Requests\Backend\[% store_request %];
use App\Http\Requests\Backend\[% update_request %];
use App\Models\[% class %];
use App\Services\UploadDocumentService;
use Exception;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Gate;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Storage;
use Symfony\Component\HttpFoundation\Response;

class [% controller %] extends Controller
{
    public function index()
    {
        abort_if(Gate::denies('[% key %] index'), Response::HTTP_FORBIDDEN);

        if (request()->ajax()) {
            $query = [% class %]::with([% with_relations %])->orderBy('id', 'desc');

            if (request()->filled('search')) {
                $search = request('search');
                $query->whereHas('translations', function ($q) use ($search) {
                    $q->where('[% title_field %]', 'like', "%$search%");
                });
            }

            return $this->dataTable($query);
        }

        return view('backend.[% key %].index');
    }

    public function create()
    {
        abort_if(Gate::denies('[% key %] create'), Response::HTTP_FORBIDDEN);

        $edit = false;
        $langs = active_langs();

        return view('backend.[% key %].form', compact('edit', 'langs'));
    }

    public function store([% store_request %] $request[% upload_parameter %])
    {
        abort_if(Gate::denies('[% key %] create'), Response::HTTP_FORBIDDEN);

        $data = $request->validated();

        DB::beginTransaction();

        try {
            $[% variable %] = [% class %]::create([
[% main_data_store %]
            ]);

            foreach (active_langs() as $lang) {
                $[% variable %]->translations()->create([
                    'locale' => $lang->code,
[% translation_data %]
                ]);
            }
[% image_uploads %]
            DB::commit();

            return redirect(route('backend.[% key %].index'))
                ->withSuccess(trans('backend.messages.success.create'));
        } catch (Exception $e) {
            DB::rollBack();
            Log::error($e->getMessage());

            return redirect()->back()->withError(trans('backend.messages.error.create'));
        }
    }

    public function show([% class %] $[% variable %])
    {
        abort_if(Gate::denies('[% key %] index'), Response::HTTP_FORBIDDEN);

        $[% variable %]->load(['translations', 'files']);
        $langs = active_langs();
        $translations = $langs->mapWithKeys(fn ($lang) => [$lang->code => $[% variable %]->translate($lang->code)]);

        return view('backend.[% key %].show', compact('[% variable %]', 'langs', 'translations'));
    }

    public function edit([% class %] $[% variable %])
    {
        abort_if(Gate::denies('[% key %] edit'), Response::HTTP_FORBIDDEN);

        $edit = true;
        $langs = active_langs();

        return view('backend.[% key %].form', compact('[% variable %]', 'edit', 'langs'));
    }

    public function update([% update_request %] $request, [% class %] $[% variable %][% upload_parameter %])
    {
        abort_if(Gate::denies('[% key %] edit'), Response::HTTP_FORBIDDEN);

        $data = $request->validated();

        DB::beginTransaction();

        try {
            $[% variable %]->update([
[% main_data_update %]
            ]);

            foreach (active_langs() as $lang) {
                $[% variable %]->translations()->updateOrCreate(
                    ['locale' => $lang->code],
                    [
[% translation_data_update %]
                    ]
                );
            }
[% image_uploads %]
            DB::commit();

            return redirect(route('backend.[% key %].index'))
                ->withSuccess(trans('backend.messages.success.update'));
        } catch (Exception $e) {
            DB::rollBack();
            Log::error($e->getMessage());

            return redirect()->back()->withError(trans('backend.messages.error.update'));
        }
    }

    public function destroy([% class %] $[% variable %])
    {
        abort_if(Gate::denies('[% key %] delete'), Response::HTTP_FORBIDDEN);

        try {
[% image_deletes %]
            $[% variable %]->delete();

            return response(['status' => 1]);
        } catch (Exception $e) {
            Log::error($e->getMessage());

            return response(['status' => 0]);
        }
    }

    protected function dataTable($query)
    {
        return datatables()
            ->of($query)
            ->addColumn('checkbox', fn ($row) => '<div class="form-check form-check-sm form-check-custom form-check-solid">
                        <input class="form-check-input" type="checkbox" value="' . $row->id . '" />
                    </div>')
            ->addColumn('[% morph_alias %]', function ($row) {
[% table_cover %]
                $title = e($row->translation->[% title_field %] ?? 'No Title');

                return '
                <div class="d-flex align-items-center">
[% datatable_columns %]
                    <div class="ms-5">
                        <a href="' . route('backend.[% key %].edit', ['[% route_parameter %]' => $row->id]) . '" class="text-gray-800 text-hover-primary fs-5 fw-bold">' . $title . '</a>
                    </div>
                </div>';
            })
[% datatable_extra_columns %]
            ->addColumn('actions', fn ($row) => $this->permissions($row->id))
            ->rawColumns([% datatable_raw_columns %])
            ->make(true);
    }

    protected function permissions($id)
    {
        $result = '<a href="#"
        class="btn btn-light btn-active-light-primary btn-flex btn-center btn-sm"
        data-kt-menu-trigger="click"
        data-kt-menu-placement="bottom-end">'
            . trans('backend.labels.actions') .
            '<i class="ki-outline ki-down fs-5 ms-1"></i>
        </a>';

        $result .= '<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-125px py-4" data-kt-menu="true">';

        if (admin()->can('[% key %] index')) {
            $result .= '<div class="menu-item px-3">
                            <a href="' . route('backend.[% key %].show', ['[% route_parameter %]' => $id]) . '" class="menu-link px-3">' . trans('backend.buttons.view') . '</a>
                        </div>';
        }

        if (admin()->can('[% key %] edit')) {
            $result .= '<div class="menu-item px-3">
                            <a href="' . route('backend.[% key %].edit', ['[% route_parameter %]' => $id]) . '" class="menu-link px-3">' . trans('backend.buttons.edit') . '</a>
                        </div>';
        }

        if (admin()->can('[% key %] delete')) {
            $result .= '<div class="menu-item px-3">
                            <a href="' . route('backend.[% key %].destroy', ['[% route_parameter %]' => $id]) . '" class="menu-link px-3 btn-delete">' . trans('backend.buttons.delete') . '</a>
                        </div>';
        }

        $result .= '</div>';

        return $result;
    }
}
